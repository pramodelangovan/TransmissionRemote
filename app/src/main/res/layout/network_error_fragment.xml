<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/window_background">
    <TextView android:id="@+id/error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.4"
        android:textColor="#8F8F8F"
        tools:text="Failed to connect to the server. Check server settings."/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <Button android:id="@+id/server_settings_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:minWidth="@dimen/default_button_with_icon_width"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:text="@string/server_parameters"
            android:textColor="@android:color/white"
            android:background="@drawable/neopop_button_outline" />
        <Button android:id="@+id/network_settings_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:minWidth="@dimen/default_button_with_icon_width"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:text="@string/network_settings"
            android:textColor="@android:color/white"
            android:background="@drawable/neopop_button_outline" />
        <Button android:id="@+id/retry_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:minWidth="@dimen/default_button_with_icon_width"
            android:textSize="12sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:text="@string/retry"
            android:textColor="@color/text_primary_inverse"
            android:background="@drawable/neopop_button_filled" />
    </LinearLayout>
    <TextView android:id="@+id/detailed_error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:textColor="#555555"
        android:gravity="center"/>
</LinearLayout>
