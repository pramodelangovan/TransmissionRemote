<?xml version="1.0" encoding="utf-8"?>
<layout>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
            xmlns:custom="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/toolbar_background"
            android:elevation="0dp"
            custom:titleTextAppearance="@style/ActionBarTitleAppearance"
            custom:subtitleTextAppearance="@style/ActionBarSubTitleAppearance"
            android:theme="@style/ToolbarTheme"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/neon_yellow"/>
        <androidx.viewpager.widget.ViewPager android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.viewpager.widget.PagerTabStrip
                android:id="@+id/pager_title_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@color/surface"
                android:textColor="@color/neon_yellow"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="@dimen/abc_text_size_subtitle_material_toolbar"/>
        </androidx.viewpager.widget.ViewPager>
    </LinearLayout>
</layout>
